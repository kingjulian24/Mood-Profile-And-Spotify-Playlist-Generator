{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SongCandidates",
  "type": "object",
  "description": "Candidate songs generated by the AI Recommendation Agent based on verified mood context.",
  "required": [
    "verified_mood",
    "candidates"
  ],
  "properties": {
    "verified_mood": {
      "type": "object",
      "required": ["intensity", "core_emotion", "branch", "specific_emotion"],
      "properties": {
        "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "core_emotion": { "type": "string" },
        "branch": { "type": "string" },
        "specific_emotion": { "type": "string" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "artist", "fit_reasoning"],
        "properties": {
          "title": { "type": "string", "description": "Track title" },
          "artist": { "type": "string", "description": "Primary artist or band name" },
          "genre": { "type": "string", "description": "Suggested genre or style" },
          "fit_reasoning": { "type": "string", "description": "Explanation of why this song matches the verified mood and intensity." }
        }
      }
    }
  }
}
