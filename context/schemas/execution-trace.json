{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionTrace",
  "type": "object",
  "description": "End-to-end execution trace record logging all stages of the Context System Design lifecycle.",
  "required": [
    "trace_id",
    "timestamp",
    "mood_selection",
    "verified_mood",
    "candidates_generated_count",
    "candidates_verified_count",
    "selected_tracks",
    "playlist_created"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Unique identifier for this generation run."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "mood_selection": {
      "type": "object",
      "description": "User's explicit structured mood selection and mood code."
    },
    "verified_mood": {
      "type": "object",
      "description": "Authoritative mood used for recommendation."
    },
    "candidates_generated_count": { "type": "integer" },
    "candidates_verified_count": { "type": "integer" },
    "selected_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "artist", "spotify_uri"],
        "properties": {
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "spotify_uri": { "type": "string" }
        }
      }
    },
    "playlist_created": { "type": "boolean" },
    "playlist_id": { "type": "string" },
    "playlist_url": { "type": "string" }
  }
}
