{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoodInterpretation",
  "type": "object",
  "description": "Structured interpretation output from the AI Mood Interpretation Agent.",
  "required": [
    "intensity",
    "core_emotion",
    "branch",
    "specific_emotion",
    "confidence",
    "is_ambiguous",
    "reasoning_summary"
  ],
  "properties": {
    "intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Estimated emotional energy activation level on a 1-10 scale."
    },
    "core_emotion": {
      "type": "string",
      "enum": ["Joy", "Sadness", "Anger", "Fear", "Disgust", "Surprise"],
      "description": "Top-level core emotion from taxonomy."
    },
    "branch": {
      "type": "string",
      "description": "Secondary emotional branch."
    },
    "specific_emotion": {
      "type": "string",
      "description": "Specific granular emotion."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of the classification."
    },
    "is_ambiguous": {
      "type": "boolean",
      "description": "True if the natural-language input has multiple plausible interpretations."
    },
    "ambiguity_alternatives": {
      "type": "array",
      "description": "Alternative candidate classifications if ambiguous.",
      "items": {
        "type": "object",
        "required": ["core_emotion", "branch", "specific_emotion"],
        "properties": {
          "core_emotion": { "type": "string" },
          "branch": { "type": "string" },
          "specific_emotion": { "type": "string" },
          "likelihood": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "reasoning_summary": {
      "type": "string",
      "description": "Concise human-readable explanation of why this mood mapping was selected."
    }
  }
}
